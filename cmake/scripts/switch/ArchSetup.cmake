set(CORE_MAIN_SOURCE ${CMAKE_SOURCE_DIR}/xbmc/platform/switch/main.cpp)

list(APPEND ARCH_DEFINES -DTARGET_POSIX -DTARGET_SWITCH -D__SWITCH__ -D_GNU_SOURCE)
set(SYSTEM_DEFINES -D__STDC_CONSTANT_MACROS -D_FILE_OFFSET_BITS=64)
set(PLATFORM_DIR platform/switch)
set(PLATFORMDEFS_DIR platform/posix)
set(ARCH aarch64)
set(CPU cortex-a57)
set(NEON True)
set(ENABLE_STATIC_LIBS TRUE)
set(USE_INTERNAL_LIBS ON)
set(HOST_CAN_EXECUTE_TARGET FALSE)

set(ENABLE_PYTHON OFF CACHE BOOL "" FORCE)
set(ENABLE_TESTING OFF CACHE BOOL "" FORCE)
set(ENABLE_UPNP OFF CACHE BOOL "" FORCE)
set(ENABLE_AIRTUNES OFF CACHE BOOL "" FORCE)
set(ENABLE_OPTICAL OFF CACHE BOOL "" FORCE)
set(ENABLE_DVDCSS OFF CACHE BOOL "" FORCE)
set(ENABLE_EVENTCLIENTS OFF CACHE BOOL "" FORCE)
set(ADDONS_CONFIGURE_AT_STARTUP OFF CACHE BOOL "" FORCE)
set(ENABLE_MICROHTTPD OFF CACHE BOOL "" FORCE)
set(ENABLE_NFS OFF CACHE BOOL "" FORCE)
set(ENABLE_CEC OFF CACHE BOOL "" FORCE)
set(ENABLE_MARIADBCLIENT OFF CACHE BOOL "" FORCE)
set(ENABLE_UDFREAD OFF CACHE BOOL "" FORCE)
set(ENABLE_INTERNAL_FMT ON CACHE BOOL "" FORCE)
set(ENABLE_INTERNAL_SPDLOG ON CACHE BOOL "" FORCE)

set(SWITCH_COMPAT_DIR ${CMAKE_SOURCE_DIR}/xbmc/platform/switch/compat)
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -I$ENV{DEVKITPRO}/portlibs/switch/include -isystem $ENV{DEVKITPRO}/libnx/include -isystem ${SWITCH_COMPAT_DIR} -include ${SWITCH_COMPAT_DIR}/switch_posix.h -D_GNU_SOURCE -D_POSIX_C_SOURCE=200809L -fno-omit-frame-pointer")
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -I$ENV{DEVKITPRO}/portlibs/switch/include -isystem $ENV{DEVKITPRO}/libnx/include -isystem ${SWITCH_COMPAT_DIR} -include ${SWITCH_COMPAT_DIR}/switch_posix.h -D_GNU_SOURCE -D_POSIX_C_SOURCE=200809L -DSPDLOG_NO_TZ_OFFSET -fno-omit-frame-pointer")
list(APPEND ARCH_DEFINES -DHAVE_NEW_CROSSGUID)
set(CMAKE_DL_LIBS "")

set(NATIVEPREFIX ${CMAKE_BINARY_DIR}/${CORE_BUILD_DIR})
file(MAKE_DIRECTORY ${NATIVEPREFIX}/share)
file(WRITE ${NATIVEPREFIX}/share/Toolchain-Native.cmake
  "set(CMAKE_SYSTEM_NAME Linux)\nset(CMAKE_C_COMPILER /usr/bin/cc)\nset(CMAKE_CXX_COMPILER /usr/bin/c++)\n")
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -L$ENV{DEVKITPRO}/portlibs/switch/lib")
